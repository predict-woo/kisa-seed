{
  "name": "kisa-seed",
  "version": "1.1.0",
  "description": "Typescript implementation of the KISA SEED encryption and decryption",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "type": "commonjs",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "check": "publint && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/predict-woo/kisa-seed.git"
  },
  "keywords": [
    "KISA",
    "SEED",
    "Encryption",
    "Decryption",
    "Typescript"
  ],
  "author": "predict-woo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/predict-woo/kisa-seed/issues"
  },
  "homepage": "https://github.com/predict-woo/kisa-seed#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.1.1",
    "publint": "^0.3.21",
    "tsdown": "^0.22.12",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
